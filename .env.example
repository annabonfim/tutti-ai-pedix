# API key da Groq Cloud — pegue gratuitamente em https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Modelo Llama via Groq. 3.3 70B é o atual; 3.1 70B foi deprecado.
GROQ_MODEL=llama-3.3-70b-versatile

# URL base da API Java (Spring Boot) do Pedix. Por padrão aponta pro
# deploy no Azure pra você não precisar subir nada local. Se quiser
# rodar a Java em localhost: http://localhost:8080
JAVA_API_BASE_URL=https://pedix-api-aab0evapangybdh7.eastus-01.azurewebsites.net
